{
  "name": "antd-restful",
  "version": "1.0.5",
  "author": "SkylerHu",
  "private": false,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "husky install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --coverage",
    "start:dev": "webpack-dev-server --config webpack.dev.config.js",
    "mock": "npx mock-restful-api --path demo/fixtures",
    "start": "concurrently \"npm run mock\" \"npm run start:dev\"",
    "build": "father build",
    "docs:dev": "dumi dev",
    "docs:build": "dumi build"
  },
  "dependencies": {
    "brace-expansion": "^2.0.1",
    "copy-to-clipboard": "^3.3.3",
    "dequal": "^2.0.3",
    "js-enumerate": "^1.1.3",
    "object-path": "^0.11.8",
    "prop-types": "^15.8.1",
    "query-string": "^9.1.1",
    "string-format": "^2.0.0"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=4",
    "antd": ">=4.24",
    "axios": ">=1.0.0",
    "dayjs": ">=1.11.0",
    "moment": ">=2.29.0",
    "react": ">=16",
    "react-dom": ">=16"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    },
    "moment": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "5.6.1",
    "@babel/cli": "^7.28.3",
    "@babel/core": "~7.24.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/preset-env": "~7.24.4",
    "@babel/preset-react": "^7.27.1",
    "@commitlint/cli": "~17.8.1",
    "@commitlint/config-conventional": "~17.8.1",
    "@formily/antd-v5": "^1.2.4",
    "@formily/core": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@jest/globals": "~29.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "antd": "5.22.5",
    "axios": "^1.7.9",
    "babel-eslint": "~10.1.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.4",
    "core-js": "^3.45.1",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.4",
    "dayjs": "^1.11.18",
    "dumi": "^2.4.48",
    "eslint": "~7.32.0",
    "eslint-config-prettier": "^4.3.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "father": "^4.6.34",
    "husky": "~8.0.3",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "~12.5.0",
    "mock-restful-api": "^0.2.0",
    "moment": "^2.30.1",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.6.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "typescript": "5.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "description": "Configuration-driven RESTful data components for Ant Design",
  "keywords": [
    "antd",
    "restful",
    "resttable",
    "restselect"
  ],
  "homepage": "https://github.com/skylerhu/antd-restful",
  "repository": {
    "type": "git",
    "url": "git@github.com:skylerhu/antd-restful.git"
  },
  "bugs": {
    "url": "https://github.com/skylerhu/antd-restful/issues"
  },
  "license": "MIT"
}
